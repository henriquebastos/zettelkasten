#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$repo_root/node_modules/node/bin:$HOME/.local/bin:$PATH"

for command in node claude codex pi; do
  command -v "$command" >/dev/null || { printf 'Missing required command: %s\n' "$command" >&2; exit 1; }
done

printf 'Harness ready: node %s; claude %s; codex %s; pi %s\n' \
  "$(node --version)" "$(claude --version)" "$(codex --version)" "$(pi --version)"
