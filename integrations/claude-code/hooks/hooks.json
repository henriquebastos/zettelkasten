{
  "description": "Allocate and display canonical Zettelkasten addresses",
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/worktree.ts"],
            "timeout": 30,
            "statusMessage": "Creating addressed Claude worktree"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/index.ts"],
            "timeout": 10,
            "statusMessage": "Resolving Zettelkasten address"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/index.ts"],
            "timeout": 10,
            "statusMessage": "Applying Zettelkasten session title"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/index.ts"],
            "timeout": 10,
            "statusMessage": "Resolving subagent Zettelkasten address"
          }
        ]
      }
    ]
  }
}
