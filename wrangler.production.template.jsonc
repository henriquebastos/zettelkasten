{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zettelkasten-allocator",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "${ZETTELKASTEN_PRODUCTION_DOMAIN}",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HIERARCHIES",
        "class_name": "Hierarchy"
      }
    ]
  },
  "exports": {
    "Hierarchy": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": [
      "SERVICE_ADMIN_TOKEN",
      "CAPABILITY_SIGNING_KEY"
    ]
  },
  "observability": {
    "enabled": true
  }
}
